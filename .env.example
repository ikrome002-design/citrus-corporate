# WordPress database
DB_NAME=wordpress_database
DB_USER=wordpress_user
DB_PASSWORD=replace-with-local-password
DB_HOST=localhost
DB_CHARSET=utf8mb4
DB_COLLATE=

# Site URLs
WP_HOME=https://example.test
WP_SITEURL=https://example.test
WP_ENVIRONMENT_TYPE=local

# Debugging
WP_DEBUG=false
WP_DEBUG_LOG=false
WP_DEBUG_DISPLAY=false

# WordPress authentication keys and salts
AUTH_KEY=replace-with-generated-key
SECURE_AUTH_KEY=replace-with-generated-key
LOGGED_IN_KEY=replace-with-generated-key
NONCE_KEY=replace-with-generated-key
AUTH_SALT=replace-with-generated-salt
SECURE_AUTH_SALT=replace-with-generated-salt
LOGGED_IN_SALT=replace-with-generated-salt
NONCE_SALT=replace-with-generated-salt
